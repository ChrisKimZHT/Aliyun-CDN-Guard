{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["log:GetCursorOrData"],
      "Resource": "acs:log:<region>:<account-id>:project/<project>/logstore/<logstore>"
    },
    {
      "Effect": "Allow",
      "Action": ["log:CreateConsumerGroup", "log:ListConsumerGroup"],
      "Resource": "acs:log:<region>:<account-id>:project/<project>/logstore/<logstore>/consumergroup/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "log:ConsumerGroupUpdateCheckPoint",
        "log:ConsumerGroupHeartBeat",
        "log:UpdateConsumerGroup",
        "log:GetConsumerGroupCheckPoint"
      ],
      "Resource": "acs:log:<region>:<account-id>:project/<project>/logstore/<logstore>/consumergroup/<consumer-group>"
    },
    {
      "Effect": "Allow",
      "Action": ["cdn:DescribeCdnDomainConfigs", "cdn:BatchSetCdnDomainConfig"],
      "Resource": [
        "acs:cdn:*:<account-id>:domain/cdn.example.com"
      ]
    }
  ]
}
